# Database initialization credentials (set before first startup)
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_ROOT_PASSWORD
MYSQL_DATABASE=dexter
MYSQL_USER=dexter
MYSQL_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD

# Discord bot and OAuth application credentials
DISCORD_BOT_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
DISCORD_OAUTH_CLIENT_ID=REPLACE_WITH_DISCORD_APPLICATION_CLIENT_ID
DISCORD_OAUTH_CLIENT_SECRET=REPLACE_WITH_DISCORD_OAUTH_CLIENT_SECRET

# Discord user IDs of site administrators; format depends on the backend
DISCORD_SITE_ADMINS=REPLACE_WITH_DISCORD_ADMIN_USER_ID

# Public service metadata; replace example domain with your actual hostname
META_SERVICE_BASE_URL=https://dexter.example.com
META_SERVICE_NAME=Dexter
META_SERVICE_DOMAIN=dexter.example.com
